# Local development only. Copy to .env. Never use this password in deployment.
POSTGRES_PASSWORD=agentflow-local-only
DATABASE_URL=postgresql+psycopg://agentflow:agentflow-local-only@localhost:55432/agentflow
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Explicit opt-in after supplying all live credentials. No paid fallback.
LIVE_ENABLED=false
RAG_ENABLED=false
# A separate read-only runtime identity; operator DATABASE_URL stays out of the API container.
RAG_DATABASE_URL=
KNOWLEDGE_READER_PASSWORD=
# Separate insert-only metrics identity with deletion restricted to expired rows.
TELEMETRY_ENABLED=false
TELEMETRY_DATABASE_URL=
METRICS_WRITER_PASSWORD=
RATE_LIMIT_HMAC_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=["localhost","127.0.0.1"]
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
