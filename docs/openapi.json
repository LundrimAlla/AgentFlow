{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentFlow API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/document": {
      "post": {
        "summary": "Document",
        "operationId": "document_api_demo_document_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "Request Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "Request Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/{corpus_id}/{source_id}": {
      "get": {
        "summary": "Source",
        "operationId": "source_api_sources__corpus_id___source_id__get",
        "parameters": [
          {
            "name": "corpus_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "title": "Corpus Id"
            }
          },
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "company",
                "products",
                "services",
                "pricing",
                "faq",
                "policies"
              ],
              "type": "string",
              "title": "Source Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceDocument"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 19,
            "minItems": 1,
            "title": "Messages"
          },
          "turnstile_token": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Turnstile Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages",
          "turnstile_token"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "live",
              "demo"
            ],
            "title": "Mode"
          },
          "answer": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "lead": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Lead"
              },
              {
                "type": "null"
              }
            ]
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            },
            "type": "array",
            "title": "Trace"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "mode",
          "answer",
          "trace"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "corpus_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Corpus Id"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "first_line": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "First Line"
          },
          "last_line": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Last Line"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "corpus_id",
          "source_id",
          "chunk_id",
          "title",
          "excerpt",
          "first_line",
          "last_line"
        ],
        "title": "Citation"
      },
      "DocumentRequest": {
        "properties": {
          "sample_id": {
            "type": "string",
            "const": "invoice-001",
            "title": "Sample Id"
          },
          "turnstile_token": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Turnstile Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sample_id",
          "turnstile_token"
        ],
        "title": "DocumentRequest"
      },
      "DocumentResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "mode": {
            "type": "string",
            "const": "live",
            "title": "Mode"
          },
          "sample_id": {
            "type": "string",
            "const": "invoice-001",
            "title": "Sample Id"
          },
          "invoice": {
            "$ref": "#/components/schemas/Invoice"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            },
            "type": "array",
            "title": "Trace"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "mode",
          "sample_id",
          "invoice",
          "trace"
        ],
        "title": "DocumentResponse"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "message",
          "request_id"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "healthy"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "Invoice": {
        "properties": {
          "invoice_number": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Invoice Number"
          },
          "invoice_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Invoice Date"
          },
          "supplier": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Supplier"
          },
          "customer": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Customer"
          },
          "currency": {
            "type": "string",
            "const": "EUR",
            "title": "Currency"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/InvoiceItem"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Items"
          },
          "subtotal_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Subtotal Cents"
          },
          "tax_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Tax Cents"
          },
          "total_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Total Cents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "invoice_number",
          "invoice_date",
          "supplier",
          "customer",
          "currency",
          "items",
          "subtotal_cents",
          "tax_cents",
          "total_cents"
        ],
        "title": "Invoice"
      },
      "InvoiceItem": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Description"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit_price_cents": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Unit Price Cents"
          },
          "total_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Total Cents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "description",
          "quantity",
          "unit_price_cents",
          "total_cents"
        ],
        "title": "InvoiceItem"
      },
      "Lead": {
        "properties": {
          "customer_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "B2B",
                  "B2C"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Type"
          },
          "company": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "product": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Product"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "urgency": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Urgency"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Lead"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "SourceDocument": {
        "properties": {
          "corpus_id": {
            "type": "string",
            "title": "Corpus Id"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "corpus_id",
          "source_id",
          "title",
          "content"
        ],
        "title": "SourceDocument"
      },
      "TraceStep": {
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "safety",
              "router",
              "lead",
              "rag",
              "document",
              "response",
              "validation"
            ],
            "title": "Agent"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed",
              "skipped"
            ],
            "title": "Status"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duration Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent",
          "status",
          "duration_ms"
        ],
        "title": "TraceStep"
      }
    }
  }
}
